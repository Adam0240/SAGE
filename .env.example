# Copy this file to .env and choose your own password before starting PostgreSQL.
# This template contains no credentials for an existing database.
POSTGRES_DB=sage
POSTGRES_USER=sage
POSTGRES_PASSWORD=

# Optional connection settings; these are the defaults for local Docker Compose.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# OctoPrint library and status. Use the server base URL (including any hosting subpath).
# API user permissions: FILES_LIST, FILES_DOWNLOAD, STATUS, FILES_SELECT, PRINT.
OCTOPRINT_URL=
OCTOPRINT_API_KEY=

